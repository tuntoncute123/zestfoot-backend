# ZestFoot NestJS Backend Environment Variables Example
PORT=3001

# PostgreSQL Connection
DATABASE_URL="postgresql://user:password@localhost:5432/zestfoot?schema=public"

# Redis Cache & Leaderboard Endpoint
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# QuestDB REST & ILP Ingestion Endpoints
QUESTDB_REST_URL="http://localhost:9000"
QUESTDB_ILP_HOST="127.0.0.1"
QUESTDB_ILP_PORT=9009

# Ollama AI Engine
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
